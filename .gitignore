# Rust build artifacts
/target/
**/target/

# OS cruft
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp

# Local environment overrides (reserved, not currently used)
.env
.env.local

# Scratch space for fixtures/fetch-corpora.sh — hand-pick files out of
# here into the tracked fixtures/ tree instead of committing wholesale.
/fixtures/external/

# NOTE: Cargo.lock is intentionally NOT ignored. This is an application
# workspace (pdfce-gui, pdfce-cli binaries), not a pure library — the
# Rust ecosystem convention is to commit the lockfile for binaries, for
# reproducible builds. See docs/ARCHITECTURE.md §2.1a.

