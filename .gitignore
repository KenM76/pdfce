# Rust build artifacts
/target/
**/target/

# OS cruft
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp

# Local environment overrides (reserved, not currently used)
.env
.env.local

# Scratch space for fixtures/fetch-corpora.sh — hand-pick files out of
# here into the tracked fixtures/ tree instead of committing wholesale.
/fixtures/external/

# Generated report from the external-corpus sweep (analysis output over the
# gitignored /fixtures/external/ tree — not source).
/fixtures/external-report.tsv

# Corpus-harness OUTPUT directories (render-parity/content-identity/etc.
# write per-run result tables + summaries + diff PNGs here; the harness
# SOURCE is tracked, its output is not). Covers out/, out-annots/,
# out-cmyk/, out-gate/, out-multipage/, and any future out-* run dir.
tools/**/out/
tools/**/out-*/

# Git worktree internals created by transient build agents — never tracked.
/.claude/worktrees/

# GUI observation screenshots (tools/observe-gui.ps1). These are diagnostic
# artifacts of whatever document happened to be open, captured to satisfy the
# operator-visible definition of done (decision 018 §11.2 / standing rule R86).
# They are deliberately NOT tracked: a screenshot of an arbitrary open PDF
# would smuggle third-party page content into the repository, bypassing the
# LEGAL.md §5 test-corpus provenance rules that govern fixtures/. The SCRIPT is
# tracked; its output is not — the same split already applied to the
# corpus-harness out-* directories above.
tools/observations/

# Stray demo/scratch artifacts written to the repo root during development.
/demo_*.pdf
/demo_*.png

# NOTE: Cargo.lock is intentionally NOT ignored. This is an application
# workspace (pdfce-gui, pdfce-cli binaries), not a pure library — the
# Rust ecosystem convention is to commit the lockfile for binaries, for
# reproducible builds. See docs/ARCHITECTURE.md §2.1a.

# NOTE: THIRD_PARTY_LICENSES.md is intentionally NOT ignored once it
# exists (generated by cargo-about) — it ships with releases. See
# docs/LEGAL.md §6.3.

# Roundtrip-harness output. The harness writes `<dir>-roundtrip.tsv` next to
# whatever corpus directory it was pointed at, so this covers the external
# corpus AND fixtures/synthetic (which a determinism check runs over). Analysis
# output, never source — same split as the tools/**/out-* rule above.
/fixtures/*-roundtrip.tsv

# Corpus-census output (tools/tw-census). Analysis over the gitignored
# external corpus — evidence, not source. Same split as the roundtrip and
# corpus-harness rules above: the TOOL is tracked, its findings are not.
/fixtures/external/tw-census*.tsv
/fixtures/external/tw-census*.txt
/fixtures/external/tw-census*.log

# fontfile-census build artefacts (out-of-tree tool, same as tools/tw-census)
tools/fontfile-census/target/

# Python bytecode caches from the tools/ scripts (check-ledger-numbers.py,
# check-passes-filed.py, the gen-*-fixtures.py generators). Regenerated on
# every run and interpreter-version-specific, so tracking them would produce
# a diff whenever anyone runs a gate on a different Python. Same tracked-tool
# / untracked-output split as the corpus-harness out-* rules above.
__pycache__/
*.py[cod]
